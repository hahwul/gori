$ErrorActionPreference = 'Stop'
$toolsDir = Split-Path -Parent $MyInvocation.MyCommand.Definition

Get-ChocolateyWebFile -PackageName 'gori' `
  -FileFullPath (Join-Path $toolsDir 'gori.exe') `
  -Url 'https://github.com/hahwul/gori/releases/download/v__VERSION__/gori-v__VERSION__-windows-x86_64.exe' `
  -Checksum '__SHA256__' -ChecksumType 'sha256'
